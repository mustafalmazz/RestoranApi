@model List<AiProjeKampi.WebUI.Dtos.ServiceDtos.ResultServiceDto>

<section id="why-us" class="why-us section light-background">

    <div class="container">

        <div class="row gy-4">

            <div class="col-lg-4" data-aos="fade-up" data-aos-delay="100">
                <div class="why-box">
                    <h3>Neden Yummy?</h3>
                    <p>
                        Yummy olarak, sofranıza gelen her tabakta en taze malzemeleri usta şeflerimizin tutkusuyla buluşturuyoruz. Eşsiz lezzetlerimiz, samimi atmosferimiz ve taviz vermediğimiz yüksek kalite standartlarımızla sizlere her ziyaretinizde unutulmaz bir gastronomi deneyimi sunuyoruz.
                    </p>
                    <div class="text-center">
                        <a href="#" class="more-btn"><span>Learn More</span> <i class="bi bi-chevron-right"></i></a>
                    </div>
                </div>
            </div>

            <div class="col-lg-8 d-flex align-items-stretch">
                <div class="row gy-4" data-aos="fade-up" data-aos-delay="200">
                    @foreach (var item in Model)
                    {
                        <div class="col-xl-4">
                            <div class="icon-box d-flex flex-column justify-content-center align-items-center">
                                <i class="@item.IconUrl"></i>
                                <h4>@item.Title</h4>
                                <p>@item.Descirption</p>
                            </div>
                        </div>

                    }
                </div>
            </div>

        </div>

    </div>

</section>